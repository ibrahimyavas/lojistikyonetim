{
  "name": "lojistik",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
    "worker:dev": "wrangler dev --port 8788",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5175",
    "cf:dev": "vite build && wrangler dev --port 8788",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply lojistik-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lojistik-db --remote"
  },
  "dependencies": {
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.462.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "wrangler": "^4.123.0"
  }
}
